import pandas as pd
import yfinance as yf

# Complete 28-column NSE Sector & Theme Rotation Universe
TICKERS = {
    # Benchmarks (2)
    "^NSEI": "NIFTY 50",
    "^CNX500": "NIFTY 500",

    # Core NSE Sectors (12)
    "^NSEBANK": "NIFTY BANK",
    "^CNXIT": "NIFTY IT",
    "^CNXPHARMA": "NIFTY PHARMA",
    "^CNXAUTO": "NIFTY AUTO",
    "^CNXFMCG": "NIFTY FMCG",
    "^CNXMETAL": "NIFTY METAL",
    "^CNXENERGY": "NIFTY ENERGY",
    "^CNXREALTY": "NIFTY REALTY",
    "^CNXPSUBANK": "NIFTY PSU BANK",
    "^CNXMEDIA": "NIFTY MEDIA",
    "^CNXINFRA": "NIFTY INFRA",
    "NIFTY_FIN_SERVICE.NS": "NIFTY FIN SERVICE",

    # NSE Thematic Indices via Liquid ETF Proxies (10)
    "MODEFENCE.NS": "NIFTY DEFENCE",
    "SELECTIPO.NS": "NIFTY IPO",
    "MOCAPITAL.NS": "NIFTY CAPITAL MKTS",
    "EVINDIA.NS": "NIFTY EV & AUTO",
    "CPSEETF.NS": "NIFTY CPSE",
    "GROWWRAIL.NS": "NIFTY RAILWAYS",
    "MAKEINDIA.NS": "NIFTY MANUFACTURING",
    "MOTOUR.NS": "NIFTY TOURISM",
    "CONSUMBEES.NS": "NIFTY CONSUMPTION",
    "TNIDETF.NS": "NIFTY DIGITAL",

    # Broad Market & Risk-Off Metals via ETF Proxies (4)
    "MID150BEES.NS": "NIFTY MIDCAP 150",
    "HDFCSML250.NS": "NIFTY SMALLCAP 250",
    "GOLDBEES.NS": "GOLD ETF",
    "SILVERBEES.NS": "SILVER ETF",
}


def main():
    raw = yf.download(
        list(TICKERS.keys()),
        period="2y",
        interval="1d",
        auto_adjust=True,
        progress=False,
    )
    closes = raw["Close"].rename(columns=TICKERS)
    closes.index = pd.to_datetime(closes.index).strftime("%Y-%m-%d")
    closes.index.name = "Date"

    # Skip any symbol that returned zero data so one bad ticker never crashes the pipeline
    valid_cols = [c for c in TICKERS.values() if c in closes.columns and closes[c].notna().any()]
    skipped = [c for c in TICKERS.values() if c not in valid_cols]

    if "NIFTY 50" not in valid_cols:
        raise RuntimeError("Benchmark NIFTY 50 (^NSEI) returned no data. Aborting CSV overwrite.")

    # Drop only rows where NIFTY 50 did not trade; use ffill() WITHOUT bfill()
    # so newer ETFs (SELECTIPO.NS, GROWWRAIL.NS) keep leading blanks prior to listing.
    closes = closes[valid_cols].dropna(subset=["NIFTY 50"]).ffill().round(2)
    closes.to_csv("eod_data.csv")

    # Summary health log for GitHub Actions output
    total_days = len(closes)
    partial_cols = [
        f"{c} ({int(closes[c].notna().sum())}d)"
        for c in valid_cols
        if closes[c].notna().sum() < total_days
    ]
    print("=== NSE EOD Sector & Theme Fetch Health Summary ===")
    print(f"Latest trading date : {closes.index[-1]}")
    print(f"Total trading days  : {total_days}")
    print(f"Active columns      : {len(valid_cols)}/{len(TICKERS)}")
    if partial_cols:
        print(f"Partial-history ETFs: {', '.join(partial_cols)}")
    if skipped:
        print(f"WARNING Skipped     : {', '.join(skipped)}")


if __name__ == "__main__":
    main()
